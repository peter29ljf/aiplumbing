# Copy this file to .env and fill in your own key. .env is gitignored.
QWEN_API_KEY=

# Optional: override the endpoint in config/llm.yaml.
# The variable name is the key name with _API_KEY swapped for _BASE_URL.
# QWEN_BASE_URL=https://llm-lhu6gyj1f60ryppl.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# --- Real services. Nothing below is used until BOTH switches are on:
# --- live_tools_enabled in config/tool_catalog.yaml, and the tool's own status.

# Texts and the call that tells a technician to check their messages
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The technician's channel. The chat id is learned when they first message the bot;
# the webhook secret is echoed by Telegram on every update and is checked on every one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# The real diary. A service account with the calendar shared to it.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or a path instead of the JSON itself
GOOGLE_APPLICATION_CREDENTIALS=
