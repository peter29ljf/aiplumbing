# Copy this file to .env and fill it in. .env is gitignored.
#
# `python3 scripts/check_live.py --all` fires one harmless call down every leg below and
# says which of them can actually reach its service. Run it before putting a customer in
# front of the flow: a leg that cannot send makes the agent refuse mid-conversation, which
# is the right thing for it to do and a bad moment to find out.

# --- the model -----------------------------------------------------------
# Whichever provider `active:` names in config/llm.yaml; the key's variable name is
# `api_key_env` in that provider's block.
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Optional: override the endpoint in config/llm.yaml.
# The variable name is the key name with _API_KEY swapped for _BASE_URL.
# QWEN_BASE_URL=https://llm-lhu6gyj1f60ryppl.cn-beijing.maas.aliyuncs.com/compatible-mode/v1


# --- what is allowed to reach the outside world --------------------------
#
# Two switches, and both have to be on before anything below is used for real. Without
# them every adapter answers "not live": the database is still written, and no text, email
# or calendar entry leaves the process.
#
# **These belong to a machine, not to the repository.** On the server they are set in the
# systemd unit, which is why config/tool_catalog.yaml stays all-mocked in git — a `git
# pull` must never be able to change what is reaching real people. Set them here only on a
# workstation you are deliberately testing a leg from.
#
# PLUMBING_LIVE_ENABLED=true
# PLUMBING_LIVE_TOOLS=telegram.send,email.send,sms.send,calendar.find_slots,calendar.create_appointment


# --- real services -------------------------------------------------------

# Texts to customers, and the inbound number webhooks arrive on.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Where scripts/check_live.py sends its test text, so a check never reaches a customer.
STAFF_PHONE_NUMBERS=

# The technician's channel, and the only way the office reaches one. A technician with no
# chat id is not offered work at all — see flow/live/world.py:_roster.
# The chat id is learned when they first message the bot (scripts/setup_telegram.py) and
# goes in config/world_seed.yaml; the webhook secret is echoed by Telegram on every update
# and is checked on every one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Photographs a quote depends on, sent to the customer and replied to by them.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USE_DELEGATION=

# The real diary. A service account with the calendar shared to it. Turning the calendar
# on writes entries a technician drives to, so it goes on only once the internal
# appointments table and the real calendar have been reconciled.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or a path instead of the JSON itself
GOOGLE_APPLICATION_CREDENTIALS=

# Where Twilio and Telegram send their webhooks back to.
PUBLIC_BASE_URL=
